# ==============================================================================
# SECURECAT V2 — DOKPLOY DEPLOYMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy the variables below and paste them into the "Environment" tab of your 
# SecureCAT Web Application inside the Dokploy dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DYNAMIC SECRETS (You must configure these in the Dokploy UI)
# ------------------------------------------------------------------------------

# Application URL
# Input the actual domain name you will map to this application in Dokploy.
# Example: https://securecat.yourdomain.com
APP_URL=https://your-domain.com

# Encryption Key (MUST be a 32-character base64 string)
# You can generate this by running: php artisan key:generate --show
# Paste the output here. Keep it secret!
APP_KEY=

# Database Credentials
# 1. Create a MySQL Database Service in Dokploy.
# 2. Retrieve the Database Name, Username, and Password from Dokploy.
# 3. DB_HOST should match the internal host or service name provided by Dokploy (usually "mysql" or similar).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=securecat
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Super Admin Account
# These credentials will be used to automatically seed your first Admin user
# when the container runs for the first time.
SUPER_ADMIN_EMAIL=sarmientodaviddatu@gmail.com
SUPER_ADMIN_PASSWORD=your_secure_admin_password
SUPER_ADMIN_NAME="Super Admin"

# AI Scheduling Assistant API Key (Optional)
# Get a free API key from https://openrouter.ai/
OPENROUTER_API_KEY=

# AI Knowledge Companion API Key (Optional)
# Get a free API key from https://www.mixedbread.com/
MIXEDBREAD_API_KEY=
MIXEDBREAD_STORE_ID=

# ------------------------------------------------------------------------------
# 2. STATIC PRODUCTION DEFAULTS (Already baked into the Docker image configuration)
# ------------------------------------------------------------------------------
# These are pre-configured to work with the Dockerfile's built-in tools.
# Only define them in Dokploy UI if you need to override these settings.

APP_NAME="SecureCAT"
APP_ENV=production
APP_DEBUG=false

# Cache, Sessions, & Queues (Minimal deployment uses the MySQL database)
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false

# PDF and Office Document Tools (Paths inside the Docker runtime)
LARAVEL_PDF_DRIVER=browsershot
LARAVEL_PDF_CHROME_PATH="/usr/bin/chromium"
LARAVEL_PDF_NO_SANDBOX=true
LARAVEL_PDF_NODE_BINARY="/usr/bin/node"
LARAVEL_PDF_NPM_BINARY="/usr/bin/npm"

LIBRE_OFFICE_PATH="/usr/bin/libreoffice"
PDFUNITE_PATH="/usr/bin/pdfunite"
DOCX_CONVERSION_TIMEOUT=120
