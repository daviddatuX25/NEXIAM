APP_NAME="NEXIAM System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexiam
DB_USERNAME=nexiam
DB_PASSWORD=nexiam-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="foundation@nexiam.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nexi assistant chrome (OpenSpec ai-assistant-foundation — no live provider)
NEXI_ENABLED=true
NEXI_MODE=degraded
NEXI_DISCLOSURE_KEY=nexi.foundation.disclosure
NEXI_DISCLOSURE_VERSION=1
NEXI_DEFAULT_INTERACTION=inquiry
NEXI_USAGE_LIMIT=50
NEXI_EMERGENCY_STOP=false

# Bootstrap HR account (StaffIdentitySeeder — local/demo only)
SEED_HR_NAME="Synthetic HR Administrator"
SEED_HR_EMAIL=hr.admin@nexiam.test
SEED_HR_PASSWORD=password

# OpenSpec 5 — AiGateway driver (fake|laravel). Default fake keeps tests offline.
NEXI_AI_GATEWAY=fake
NEXI_AI_PROVIDER=openai
NEXI_AI_MODEL=gpt-4o-mini
NEXI_AI_TIMEOUT=30
OPENAI_API_KEY=
