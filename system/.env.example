APP_NAME="NEXIAM System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Comma-separated, operator-verified IPs/CIDRs for the immediate reverse proxy.
# Empty trusts no remote proxy; configure explicitly when deploying behind one.
TRUSTED_PROXIES=

# Staff Google sign-in: bash configure-google-oauth.sh [existing-env-file]
# Register the exact runtime callback URI in Google Cloud before activating.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexiam
DB_USERNAME=nexiam
DB_PASSWORD=nexiam-local-only
# Isolated database for Research TAM Evaluations (defaults to SQLite: database/tam_evaluations.sqlite)
# DB_TAM_DATABASE=/path/to/tam_evaluations.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Plunk SMTP setup: bash configure-plunk-smtp.sh [existing-env-file]
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="foundation@nexiam.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional Web Push: configure a matching generated pair; no embedded fallback.
# Keep the existing pair when upgrading a deployment with subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PRIVATE_PEM=
VAPID_SUBJECT=mailto:admin@example.test

VITE_APP_NAME="${APP_NAME}"

# Xiam assistant chrome (OpenSpec — no live provider by default)
XIAM_ENABLED=true
XIAM_MODE=degraded
XIAM_DISCLOSURE_KEY=xiam.foundation.disclosure
XIAM_DISCLOSURE_VERSION=1
XIAM_DEFAULT_INTERACTION=inquiry
XIAM_USAGE_LIMIT=50
XIAM_EMERGENCY_STOP=false

# Bootstrap HR account (StaffIdentitySeeder — local/demo only)
SEED_HR_NAME="Synthetic HR Administrator"
SEED_HR_EMAIL=hr.admin@nexiam.test
SEED_HR_PASSWORD=password

# AiGateway driver (fake|laravel). Default fake keeps tests offline.
XIAM_AI_GATEWAY=fake
XIAM_AI_PROVIDER=openai
XIAM_AI_MODEL=gpt-4o-mini
XIAM_AI_TIMEOUT=30
OPENAI_API_KEY=

# OMR worker transport (Laravel's `php artisan serve` spawns the built-in
# server with a stripped environment, so these MUST live in .env — the same
# reason APP_KEY is seeded there — for the web runtime to reach the worker).
OMR_WORKER_ENABLED=true
OMR_WORKER_ENDPOINT=http://inference:8100
OMR_WORKER_SIGNING_SECRET=nexiam-local-omr-worker-signing-secret-change-me
OMR_WORKER_CONTRACT_VERSION=nexiam.omr.detection.v3
OMR_WORKER_ENGINE_NAME=OMRChecker
OMR_WORKER_ENGINE_COMMIT=de3f6982822895491be760325fd43e65e90fa293
OMR_WORKER_PATCH_IDENTITY=nexiam-explicit-bubble-positions-v1
OMR_QR_CURRENT_KEY_ID=dev-v1
OMR_QR_KEY_DEV_V1=nexiam-local-qr-signing-secret-change-me

# Remote pairing remains disabled until two-device/network acceptance.
OMR_CAMERA_REMOTE_ENABLED=false
# Optional authenticated OMR relay; disabled until verified public routing/TLS.
# The same random secret belongs to Laravel and the opt-in omr-turn service.
# Never commit a real secret, certificate or key, or use the HTTPS app tunnel.
OMR_CAMERA_TURN_URLS=
OMR_CAMERA_TURN_SHARED_SECRET=
OMR_CAMERA_TURN_REALM=
OMR_CAMERA_TURN_EXTERNAL_IP=
OMR_CAMERA_TURN_TTL_SECONDS=600
# Keep loopback until TURN DNS, public routing/firewall and TLS are verified.
OMR_CAMERA_TURN_BIND_IP=127.0.0.1
# Bind-mounted cert.pem/key.pem must be readable by coturn's UID/GID 65534.
OMR_CAMERA_TURN_TLS_DIRECTORY=./docker/omr-turn/tls-not-configured

# Admission Decision Support Engine (TabFM & YuKee)

# TabPFN inference checkpoint
TABPFN_CHECKPOINT_HOST_PATH=./docker/tabfm/model.ckpt
TABPFN_CHECKPOINT_ID=Prior-Labs/tabpfn_3/tabpfn-v3-classifier-v3_20260417_binary.ckpt
TABPFN_CHECKPOINT_SHA256=1f9949fd52e20b6ed8ece20b3b37242d2abbbf337d14b461a4244f9318031a88
TABPFN_DEVICE=cpu
ADMISSION_ENGINE_TABFM_DRIVER=http
ADMISSION_ENGINE_TABFM_ENDPOINT=http://tabfm-inference:8101
ADMISSION_ENGINE_TABFM_TIMEOUT=3.0
CIAM_MFA_ENABLED=true
PUBLIC_SITE_PREVIEW=false
