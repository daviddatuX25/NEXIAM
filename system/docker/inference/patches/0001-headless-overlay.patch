From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NEXIAM <engineering@nexiam.test>
Date: Wed, 12 Aug 2026 00:00:00 +0000
Subject: [PATCH] make provider imports headless and bind overlay coordinates

The provider never opens debug windows, so importing screeninfo at module load
must not make the worker depend on a desktop monitor. Keep debug rendering
available when explicitly requested with conservative dimensions.

The overlay branch previously used x/y only when a bubble was marked, then
referenced those variables for the unmarked branch. Bind the shifted bubble
origin before classification; this does not change geometry or thresholds.

---
 src/core.py               | 5 +++--
 src/utils/interaction.py | 9 +++++----
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/core.py b/src/core.py
--- a/src/core.py
+++ b/src/core.py
@@ -344,17 +344,14 @@ class ImageInstanceOps:
                     # TODO: get rid of total_q_box_no
                     detected_bubbles = []
                     for bubble in field_block_bubbles:
+                        x, y = bubble.x + field_block.shift, bubble.y
                         bubble_is_marked = (
                             per_q_strip_threshold > all_q_vals[total_q_box_no]
                         )
                         total_q_box_no += 1
                         if bubble_is_marked:
                             detected_bubbles.append(bubble)
-                            x, y, field_value = (
-                                bubble.x + field_block.shift,
-                                bubble.y,
-                                bubble.field_value,
-                            )
+                            field_value = bubble.field_value
                             cv2.rectangle(
                                 final_marked,
                                 (int(x + box_w / 12), int(y + box_h / 12)),

diff --git a/src/utils/interaction.py b/src/utils/interaction.py
--- a/src/utils/interaction.py
+++ b/src/utils/interaction.py
@@ -1,7 +1,6 @@
 from dataclasses import dataclass
 
 import cv2
-from screeninfo import get_monitors
 
 from src.logger import logger
 from src.utils.image import ImageUtils
@@ -9,3 +8,2 @@
-monitor_window = get_monitors()[0]
 
 
@@ -13,6 +12,9 @@
 class ImageMetrics:
     # TODO: Move TEXT_SIZE, etc here and find a better class name
-    window_width, window_height = monitor_window.width, monitor_window.height
+    # Provider mode never queries a desktop monitor at import time. These
+    # conservative values only position optional explicitly enabled previews.
+    window_width: int = 1920
+    window_height: int = 1080
     # for positioning image windows
     window_x, window_y = 0, 0
     reset_pos = [0, 0]
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NEXIAM <engineering@nexiam.test>
Date: Wed, 12 Aug 2026 00:00:00 +0000
Subject: [PATCH] return the clean aligned raster from read_omr_response

The second tuple value is the debug-annotated final_marked canvas (marked
rectangles, value labels, translucent overlay), which NEXIAM previously
stored as clean aligned evidence. Return the pre-annotation page raster as
final_align instead; debug previews move to align_preview and stay internal
to the optional show_image_level paths. Classification is untouched.

---
 src/core.py | 25 ++++++++++++++++++++-----
 1 file changed, 20 insertions(+), 5 deletions(-)

diff --git a/src/core.py b/src/core.py
--- a/src/core.py
+++ b/src/core.py
@@ -59,6 +59,9 @@
             # Processing copies
             transp_layer = img.copy()
             final_marked = img.copy()
+            # Clean aligned raster: returned to callers as unannotated
+            # evidence. Debug marks are only ever drawn on final_marked.
+            final_align = img.copy()
 
             morph = img.copy()
             self.append_save_img(3, morph)
@@ -198,18 +201,20 @@
                     #   "origin:", field_block.origin,'\n')
                 # print("End Alignment")
 
-            final_align = None
+            # Debug-only alignment preview; never returned to callers so the
+            # clean aligned raster stays unannotated.
+            align_preview = None
             if config.outputs.show_image_level >= 2:
                 initial_align = self.draw_template_layout(img, template, shifted=False)
-                final_align = self.draw_template_layout(
+                align_preview = self.draw_template_layout(
                     img, template, shifted=True, draw_qvals=True
                 )
                 # appendSaveImg(4,mean_vals)
                 self.append_save_img(2, initial_align)
-                self.append_save_img(2, final_align)
+                self.append_save_img(2, align_preview)
 
                 if auto_align:
-                    final_align = np.hstack((initial_align, final_align))
+                    align_preview = np.hstack((initial_align, align_preview))
             self.append_save_img(5, img)
 
             # Get mean bubbleValues n other stats
@@ -408,13 +413,13 @@
                 plt.tight_layout(pad=0.5)
                 plt.show()
 
-            if config.outputs.show_image_level >= 3 and final_align is not None:
-                final_align = ImageUtils.resize_util_h(
-                    final_align, int(config.dimensions.display_height)
+            if config.outputs.show_image_level >= 3 and align_preview is not None:
+                align_preview = ImageUtils.resize_util_h(
+                    align_preview, int(config.dimensions.display_height)
                 )
                 # [final_align.shape[1],0])
                 InteractionUtils.show(
-                    "Template Alignment Adjustment", final_align, 0, 0, config=config
+                    "Template Alignment Adjustment", align_preview, 0, 0, config=config
                 )
 
             if config.outputs.save_detections and save_dir is not None:
@@ -429,7 +434,7 @@
                 for i in range(config.outputs.save_image_level):
                     self.save_image_stacks(i + 1, name, save_dir)
 
-            return omr_response, final_marked, multi_marked, multi_roll
+            return omr_response, final_align, multi_marked, multi_roll
 
         except Exception as e:
             raise e
*** End Patch
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NEXIAM <engineering@nexiam.test>
Date: Sun, 27 Sep 2026 00:00:00 +0000
Subject: [PATCH] recognize explicit bubble positions in pinned templates

Allow an optional field-label by bubble-value matrix of absolute pixel
coordinates. Validate its structure and page bounds before constructing
ordered Bubble objects; leave the regular-grid path unchanged.

---
 src/template.py | 87 ++++++++++++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 67 insertions(+), 20 deletions(-)

diff --git a/src/template.py b/src/template.py
--- a/src/template.py
+++ b/src/template.py
@@ -142,6 +142,6 @@ class Template:
     def parse_and_add_field_block(self, block_name, field_block_object):
         field_block_object = self.pre_fill_field_block(field_block_object)
-        block_instance = FieldBlock(block_name, field_block_object)
+        block_instance = FieldBlock(block_name, field_block_object, self.page_dimensions)
         self.field_blocks.append(block_instance)
         self.validate_parsed_labels(field_block_object["fieldLabels"], block_instance)
 
@@ -199,9 +199,9 @@ class FieldBlock:
-    def __init__(self, block_name, field_block_object):
+    def __init__(self, block_name, field_block_object, page_dimensions):
         self.name = block_name
         self.shift = 0
-        self.setup_field_block(field_block_object)
+        self.setup_field_block(field_block_object, page_dimensions)
 
-    def setup_field_block(self, field_block_object):
+    def setup_field_block(self, field_block_object, page_dimensions):
         # case mapping
         (
             bubble_dimensions,
@@ -211,6 +211,7 @@ class FieldBlock:
             field_type,
             labels_gap,
             origin,
+            bubble_positions,
             self.empty_val,
         ) = map(
             field_block_object.get,
@@ -222,6 +223,7 @@ class FieldBlock:
                 "fieldType",
                 "labelsGap",
                 "origin",
+                "bubblePositions",
                 "emptyValue",
             ],
         )
@@ -230,20 +232,87 @@ class FieldBlock:
         )
+        has_explicit_bubble_positions = "bubblePositions" in field_block_object
         self.origin = origin
         self.bubble_dimensions = bubble_dimensions
-        self.calculate_block_dimensions(
-            bubble_dimensions,
-            bubble_values,
-            bubbles_gap,
-            direction,
-            labels_gap,
-        )
-        self.generate_bubble_grid(
-            bubble_values,
-            bubbles_gap,
-            direction,
-            field_type,
-            labels_gap,
-        )
+        if not has_explicit_bubble_positions:
+            self.calculate_block_dimensions(
+                bubble_dimensions,
+                bubble_values,
+                bubbles_gap,
+                direction,
+                labels_gap,
+            )
+            self.generate_bubble_grid(
+                bubble_values,
+                bubbles_gap,
+                direction,
+                field_type,
+                labels_gap,
+            )
+        else:
+            self.generate_explicit_bubbles(
+                bubble_positions,
+                bubble_values,
+                field_type,
+                page_dimensions,
+            )
+
+    def generate_explicit_bubbles(
+        self, bubble_positions, bubble_values, field_type, page_dimensions
+    ):
+        if (
+            not isinstance(bubble_positions, list)
+            or len(bubble_positions) != len(self.parsed_field_labels)
+            or not isinstance(bubble_values, list)
+            or not bubble_values
+        ):
+            raise ValueError(f"Invalid bubblePositions dimensions in field block '{self.name}'")
+
+        bubble_width, bubble_height = self.bubble_dimensions
+        page_width, page_height = page_dimensions
+        if (
+            type(bubble_width) is not int
+            or type(bubble_height) is not int
+            or bubble_width <= 0
+            or bubble_height <= 0
+            or type(page_width) is not int
+            or type(page_height) is not int
+            or page_width <= 0
+            or page_height <= 0
+        ):
+            raise ValueError(f"Invalid bubble or page dimensions in field block '{self.name}'")
+
+        positions = []
+        for label_positions in bubble_positions:
+            if not isinstance(label_positions, list) or len(label_positions) != len(bubble_values):
+                raise ValueError(f"Invalid bubblePositions dimensions in field block '{self.name}'")
+            row = []
+            for point in label_positions:
+                if (
+                    not isinstance(point, list)
+                    or len(point) != 2
+                    or type(point[0]) is not int
+                    or type(point[1]) is not int
+                ):
+                    raise ValueError(f"Invalid bubblePositions coordinate in field block '{self.name}'")
+                x, y = point
+                if x < 0 or y < 0 or x + bubble_width >= page_width or y + bubble_height >= page_height:
+                    raise ValueError(f"bubblePositions outside page in field block '{self.name}'")
+                row.append((x, y))
+            positions.append(row)
+
+        min_x = min(x for row in positions for x, _y in row)
+        min_y = min(y for row in positions for _x, y in row)
+        max_x = max(x for row in positions for x, _y in row)
+        max_y = max(y for row in positions for _x, y in row)
+        self.origin = [min_x, min_y]
+        self.dimensions = [max_x - min_x + bubble_width, max_y - min_y + bubble_height]
+        self.traverse_bubbles = [
+            [
+                Bubble([x, y], field_label, field_type, bubble_value)
+                for (x, y), bubble_value in zip(row, bubble_values)
+            ]
+            for field_label, row in zip(self.parsed_field_labels, positions)
+        ]
 
     def calculate_block_dimensions(
         self,
