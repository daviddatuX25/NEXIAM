<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="OMR PostgreSQL acceptance">
            <file>tests/Unit/Assessment/OmrPhysicalAssurancePostgresAcceptanceTest.php</file>
            <file>tests/Unit/Assessment/OmrPreparedCaptureEvidenceTest.php</file>
            <file>tests/Unit/Assessment/OmrEvidencePageTest.php</file>
            <file>tests/Feature/Assessment/OmrCanonicalSchemaConstraintTest.php</file>
            <file>tests/Unit/Assessment/OmrSourceRectificationPostgresAcceptanceTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="NEXIAM_TEST_PIN_SQLITE" value="0" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <env name="PEST_BROWSER_ENABLED" value="false" force="true"/>
        <env name="OMR_PROVIDER" value="fake" force="true"/>
        <env name="OMR_ALLOW_FAKE_PROVIDER" value="true" force="true"/>
        <env name="INERTIA_DEVTOOLS_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
