{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "dev": "vite",
        "format:check": "prettier --check 'resources/**/*.{css,js,ts,svelte}' 'tests/**/*.{js,ts}' '*.{js,ts,json,yml,yaml}' 'vite.config.ts'",
        "lint": "eslint 'resources/js/**/*.{js,ts,svelte}' 'tests/**/*.{js,ts}' --max-warnings=0",
        "test": "vitest run",
        "test:browser": "playwright test",
        "quality": "npm run check && npm run lint && npm run format:check && npm run test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^24.13.3",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^17.9.0",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte-check": "^4.7.4",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.0.7",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@inertiajs/svelte": "^3.6.1",
        "bits-ui": "^2.15.6",
        "clsx": "^2.1.1",
        "lucide-svelte": "^0.574.0",
        "motion": "^12.43.0",
        "qrcode": "^1.5.4",
        "svelte": "^5.51.3",
        "tailwind-merge": "^3.4.1",
        "tailwind-variants": "^3.2.2",
        "tw-animate-css": "^1.4.0"
    }
}
