{
  "evaluations": [
    {
      "name": "round retains the intermediate arithmetic limit",
      "expression": "ROUND(A*A,0)/(A*A)",
      "allowed_variables": ["A"],
      "values": {"A": "9999999999999999999999999999999999999999"},
      "scale": 0,
      "expected": "1"
    },
    {
      "name": "repeated decimal inputs use reduced exact rationals",
      "expression": "A+A+A+A+A+A",
      "allowed_variables": ["A"],
      "values": {"A": "0.123456789012345678901234567890123456789012345678901234567890"},
      "scale": 6,
      "expected": "0.740741"
    },
    {
      "name": "decimal addition stays exact",
      "expression": "0.1 + 0.2",
      "allowed_variables": [],
      "values": {},
      "scale": 1,
      "expected": "0.3"
    },
    {
      "name": "weighted formula with explicit rounding",
      "expression": "=ROUND(0.20*A+0.80*B,0)",
      "allowed_variables": ["A", "B"],
      "values": {"A": "20", "B": "30"},
      "scale": 0,
      "expected": "28"
    },
    {
      "name": "average of a repeating fraction",
      "expression": "AVERAGE(A,B,C)",
      "allowed_variables": ["A", "B", "C"],
      "values": {"A": "1", "B": "0", "C": "0"},
      "scale": 6,
      "expected": "0.333333"
    },
    {
      "name": "AVG alias canonicalizes and averages one pair",
      "expression": "AVG(a,b)",
      "allowed_variables": ["A", "B"],
      "values": {"A": "1", "B": "2"},
      "scale": 2,
      "expected": "1.50",
      "expected_variables": ["A", "B"],
      "expected_ast": {
        "type": "call",
        "name": "AVERAGE",
        "arguments": [
          {"type": "variable", "name": "A"},
          {"type": "variable", "name": "B"}
        ]
      }
    },
    {
      "name": "negative half ties round away from zero",
      "expression": "ROUND(-1.25,1)",
      "allowed_variables": [],
      "values": {},
      "scale": 1,
      "expected": "-1.3"
    },
    {
      "name": "negative integer tie rounds away from zero",
      "expression": "ROUND(-2.5,0)",
      "allowed_variables": [],
      "values": {},
      "scale": 0,
      "expected": "-3"
    },
    {
      "name": "operator precedence and left associativity",
      "expression": "1+2*3-4/2",
      "allowed_variables": [],
      "values": {},
      "scale": 0,
      "expected": "5"
    },
    {
      "name": "one variable and min max sum",
      "expression": "SUM(MIN(A,B),MAX(A,B))",
      "allowed_variables": ["A", "B"],
      "values": {"A": "2", "B": "5"},
      "scale": 0,
      "expected": "7",
      "expected_variables": ["A", "B"]
    },
    {
      "name": "single variable formula",
      "expression": "0.20*A",
      "allowed_variables": ["A"],
      "values": {"A": "12.5"},
      "scale": 2,
      "expected": "2.50",
      "expected_variables": ["A"]
    }
  ],
  "bounds": [
    {
      "name": "rounded intermediate bounds retain the arithmetic limit",
      "expression": "ROUND(A*A,0)/(A*A)",
      "allowed_variables": ["A"],
      "ranges": {"A": {"min": "9999999999999999999999999999999999999999", "max": "9999999999999999999999999999999999999999"}},
      "scale": 0,
      "expected": {"min": "1", "max": "1"}
    },
    {
      "name": "correlated variable interval remains conservative",
      "expression": "A-A",
      "allowed_variables": ["A"],
      "ranges": {"A": {"min": "0", "max": "10"}},
      "scale": 0,
      "expected": {"min": "-10", "max": "10"}
    },
    {
      "name": "division extrema round outward",
      "expression": "A/B",
      "allowed_variables": ["A", "B"],
      "ranges": {"A": {"min": "1", "max": "2"}, "B": {"min": "3", "max": "6"}},
      "scale": 2,
      "expected": {"min": "0.16", "max": "0.67"}
    },
    {
      "name": "negative bounds use outward grid points",
      "expression": "A/3",
      "allowed_variables": ["A"],
      "ranges": {"A": {"min": "-1", "max": "1"}},
      "scale": 2,
      "expected": {"min": "-0.34", "max": "0.34"}
    }
  ],
  "missing": {
    "expression": "A+B",
    "allowed_variables": ["A", "B"],
    "values": {"A": "1"}
  },
  "invalid_formulas": [
    {"name": "malformed syntax", "expression": "A + * B", "allowed_variables": ["A", "B"]},
    {"name": "unknown function", "expression": "MAGIC(A)", "allowed_variables": ["A"]},
    {"name": "unknown variable", "expression": "A+C", "allowed_variables": ["A", "B"]},
    {"name": "function arity", "expression": "SUM()", "allowed_variables": []},
    {"name": "round precision must be a literal from zero to six", "expression": "ROUND(A,7)", "allowed_variables": ["A"]},
    {"name": "unsupported exponent syntax", "expression": "1e3", "allowed_variables": []},
    {"name": "hyphenated stable code is explicitly rejected", "expression": "A-B", "allowed_variables": ["A-B", "A", "B"]}
  ],
  "invalid_bounds": [
    {
      "name": "divisor interval crosses zero",
      "expression": "A/B",
      "allowed_variables": ["A", "B"],
      "ranges": {"A": {"min": "1", "max": "2"}, "B": {"min": "-1", "max": "3"}}
    },
    {
      "name": "reversed input range",
      "expression": "A",
      "allowed_variables": ["A"],
      "ranges": {"A": {"min": "2", "max": "1"}}
    }
  ],
  "malicious_asts": [
    {"type": "number", "value": "1", "code": "eval"},
    {"type": "call", "name": "EVAL", "arguments": [{"type": "number", "value": "1"}]},
    {"type": "variable", "name": "A-B"},
    {"type": "number", "value": "1e3"}
  ],
  "limits": {
    "unary_depth": 32,
    "node_terms": 129,
    "formula_length": 2049,
    "oversized_decimal": "12345678901234567890123456789012345678901234567890123456789012345"
  }
}
