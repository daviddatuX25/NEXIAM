APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=password

SESSION_DRIVER=database
# 120 = 2h. For dev, use 10080 (1 week) to avoid "Session expired" during testing
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# For local email testing without a queue worker, use sync so Accept/Resend setup email send immediately:
# QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenRouter API (for AI exam scheduling assistant; free models only)
OPENROUTER_API_KEY=
# Optional: default openrouter/free; use a specific :free model if desired
# OPENROUTER_MODEL=openrouter/free

# Mixedbread API (for AI Companion RAG embeddings)
MIXEDBREAD_API_KEY=
MIXEDBREAD_STORE_ID=
MIXEDBREAD_BASE_URL=https://api.mixedbread.com/v1

# Login rate limiting (disable in dev with LOGIN_THROTTLE_ENABLED=false)
LOGIN_THROTTLE_ENABLED=true
LOGIN_THROTTLE_ATTEMPTS=5
LOGIN_THROTTLE_DECAY_MINUTES=15

# Demo mode — set DEMO=true to auto-run DefenseDemoSeeder after db:seed
# and to enable fast rate-limit expiry for live demonstrations.
# Run: php artisan demo:setup
DEMO=false
DEMO_THROTTLE_DECAY_SECONDS=   # e.g. 15 — overrides decay minutes when DEMO=true
DEMO_THROTTLE_ATTEMPTS=        # e.g. 3  — overrides max attempts when DEMO=true

# Super Admin user (created on db:seed)
SUPER_ADMIN_EMAIL=sarmientodaviddatu@gmail.com
SUPER_ADMIN_PASSWORD=Password1!
SUPER_ADMIN_NAME="Super Admin"

# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# Token expiry (overridable for demo/testing).
SETUP_TOKEN_EXPIRES_HOURS=72
RESET_TOKEN_EXPIRES_MINUTES=15

# PDF Export (Browsershot / Puppeteer)
LARAVEL_PDF_DRIVER=browsershot
# Local (Windows): "C:/Program Files/Google/Chrome/Application/chrome.exe"
# Production (Linux Docker): "/usr/bin/chromium"
LARAVEL_PDF_CHROME_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"
LARAVEL_PDF_NO_SANDBOX=false # Set to true in Dokploy (Linux Docker)
# Local (Windows): "C:/Program Files/nodejs/node.exe"
# Production (Linux Docker): "/usr/bin/node"
LARAVEL_PDF_NODE_BINARY="C:/Program Files/nodejs/node.exe"
# Local (Windows): "C:/Program Files/nodejs/npm.cmd"
# Production (Linux Docker): "/usr/bin/npm"
LARAVEL_PDF_NPM_BINARY="C:/Program Files/nodejs/npm.cmd"

# LibreOffice DOCX to PDF Conversion
# Local (Windows): "C:/Program Files/LibreOffice/program/soffice.exe"
# Production (Linux Docker): "/usr/bin/libreoffice"
LIBRE_OFFICE_PATH="C:/Program Files/LibreOffice/program/soffice.exe"
DOCX_CONVERSION_TIMEOUT=120

# PDFUnite Path (for merging PDFs)
# Local (Windows): "" (defaults to shell execution if not set)
# Production (Linux Docker): "/usr/bin/pdfunite"
PDFUNITE_PATH=""


# ── Institution Configuration ──────────────────────────────
# Appear on result sheets, admission slips, homepage, and reports.
# Can be overridden from Setup > Institution in admin UI.
# NOTE: Academic year is managed separately via Admin > Academic Years CRUD.

# Profile
INSTITUTION_NAME="ISPSC"
INSTITUTION_CAMPUS="Tagudin Campus"
INSTITUTION_ADDRESS=""
INSTITUTION_CONTACT_NUMBER=""
INSTITUTION_EMAIL=""
INSTITUTION_WEBSITE=""

# Exam branding
INSTITUTION_EXAM_NAME="ISPSC College Admission Test"
INSTITUTION_EXAM_ACRONYM="ICAT"

# Key Personnel — static names/titles for documents (NOT admin accounts)
INSTITUTION_GUIDANCE_COUNSELOR="RAVEENA GALOPE, RGC, RPm"
INSTITUTION_GUIDANCE_COUNSELOR_TITLE="Guidance Counselor"
INSTITUTION_GUIDANCE_COUNSELOR_CREDENTIALS="RGC, RPm"
INSTITUTION_REGISTRAR=""
INSTITUTION_REGISTRAR_TITLE="Registrar"
INSTITUTION_COLLEGE_PRESIDENT=""
INSTITUTION_COLLEGE_PRESIDENT_TITLE="College President"
INSTITUTION_CAMPUS_DIRECTOR=""
INSTITUTION_CAMPUS_DIRECTOR_TITLE="Campus Director"
INSTITUTION_VP_ACADEMIC_AFFAIRS=""
INSTITUTION_VP_ACADEMIC_AFFAIRS_TITLE="VP for Academic Affairs"
INSTITUTION_DEAN=""
INSTITUTION_DEAN_TITLE="Dean"
INSTITUTION_TESTING_COORDINATOR=""
INSTITUTION_TESTING_COORDINATOR_TITLE="Testing Coordinator"
